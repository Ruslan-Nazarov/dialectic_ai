# Verified working configuration (2026-09-19): GigaChat-2-Max as the actor,
# Gemini + Cerebras as distinct judges (never the same provider as the actor).
# Groq is excluded from judging -- a point-test caught it false-rejecting a
# genuinely valid DESIGNATE_OPPOSITE proposal. It can still be used as an
# actor provider if you want to test it in that role.
#
# Copy this file to .env and fill in your own keys.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Max
# Path to a CA bundle if your system doesn't trust Sber's certificate chain.
# Never leave TLS verification disabled -- see dialectic_ai/integrations/gigachat/llm.py.
GIGACHAT_CA_BUNDLE=

OPENAI_API_KEY=
OPENAI_MODEL=
# Only for OpenAI-compatible proxies; leave empty for api.openai.com.
OPENAI_BASE_URL=

# NVIDIA: the API catalog (build.nvidia.com) by default. For a self-hosted model on an NVIDIA
# Brev instance (vLLM/NIM), set NVIDIA_BASE_URL to the instance, e.g. https://<host>/v1 -- the
# key is optional there. NVIDIA_MODEL is the model id the endpoint serves.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Live suite roles (tests/live): actor provider, judge fallback chain (never the actor's model).
# DIALECTIC_LIVE_ACTOR=gigachat
# DIALECTIC_LIVE_JUDGE=nvidia,cerebras
# DIALECTIC_LIVE_MAX_TOKENS=1600
